# Analyzer Service Configuration
PORT=6001
MAX_FILE_SIZE_BYTES=524288
MAX_TOTAL_FILES=5000
GITHUB_API_TIMEOUT_MS=15000

# Internal Service Authentication
# Must match ANALYZER_INTERNAL_TOKEN in the Backend .env
# Generate with: node -e "require('crypto').randomBytes(32).toString('hex') |> console.log"
ANALYZER_INTERNAL_TOKEN=
