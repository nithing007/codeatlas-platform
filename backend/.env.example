# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/codeatlas

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Authentication Cookie
AUTH_COOKIE_NAME=codeatlas_auth
AUTH_COOKIE_MAX_AGE=604800000

# OTP
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Frontend URL (for CORS and OAuth redirect)
CLIENT_URL=http://localhost:5173

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Analyzer Service
ANALYZER_URL=http://localhost:6001
# Must match ANALYZER_INTERNAL_TOKEN in the Analyzer .env
ANALYZER_INTERNAL_TOKEN=
ANALYZER_TIMEOUT_MS=120000

# Email / SMTP Delivery (Phase 7C.1)
# Option 1: Gmail with App Password (RECOMMENDED for easy testing)
# Generate App Password: https://myaccount.google.com/apppasswords
SMTP_SERVICE=gmail
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Option 2: Custom SMTP / SendGrid / Mailgun / AWS SES / MailHog
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=CodeAtlas <noreply@codeatlas.dev>
#
# Note: If no SMTP credentials are provided, development mode logs OTPs to the console.
